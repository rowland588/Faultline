# Cloud sync (optional). Finder works fully offline without these; set both to
# enable Supabase backup + multi-device sync. Values: Supabase Dashboard →
# Project Settings → API. Add the same two to Vercel → Environment Variables.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
